# Use: openssl rand -hex 32 (generate a DIFFERENT secret for each variable)
ADMIN_TOKEN=REPLACE_WITH_STRONG_RANDOM_SECRET
ENROLLMENT_TOKEN=REPLACE_WITH_DIFFERENT_STRONG_RANDOM_SECRET
SEED_DEMO=true
DATABASE_PATH=/data/scanlattice.db
WORKER_OFFLINE_SECONDS=45
JOB_LEASE_SECONDS=90
MAX_JOB_TARGETS=4096
MAX_JOB_PORTS=100
MAX_BODY_BYTES=2097152
PUBLIC_RATE_LIMIT=60
LOGIN_RATE_LIMIT=5
ADMIN_SESSION_SECONDS=28800
# Keep true behind production HTTPS. Set false only for local HTTP tests.
SESSION_COOKIE_SECURE=true
PASSIVE_ENRICHMENT_ENABLED=true
MAX_ENRICHMENT_QUEUE=100
MAX_CAMPAIGN_TARGETS=65536
MAX_BATCH_TARGETS=256
